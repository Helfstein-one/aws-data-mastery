<mxfile host="Electron" modified="2026-06-13T14:00:00.000Z" agent="Mozilla/5.0" version="21.2.8" type="device">
  <diagram id="sqs_dlq" name="SQS DLQ LIFECYCLE">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="380" math="0" shadow="0" background="#080f1e">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bg" value="CICLO DE VIDA DA MENSAGEM: VISIBILITY TIMEOUT E DEAD LETTER QUEUE (DLQ)" style="rounded=1;fillColor=#1e293b;strokeColor=#475569;fontColor=#94a3b8;fontFamily=DM Sans;fontSize=12;verticalAlign=top;align=center;spacingTop=10;dashed=1;dashPattern=4 4;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="840" height="320" as="geometry" />
        </mxCell>

        <!-- SQS Main -->
        <mxCell id="sqs" value="Fila SQS&#10;(Principal)" style="shape=image;image=https://raw.githubusercontent.com/Helfstein-one/aws-data-mastery/feature/aws-certifications/assets/aws-icons/SimpleQueueService.png;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#ffffff;fontFamily=DM Sans;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- Invisible Area -->
        <mxCell id="invis" value="Zona de Invisibilidade (Visibility Timeout = 30s)" style="rounded=1;fillColor=#1a0526;strokeColor=#7c3aed;fontColor=#c4b5fd;fontFamily=DM Sans;fontSize=10;verticalAlign=top;align=center;spacingTop=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="80" width="280" height="200" as="geometry" />
        </mxCell>

        <mxCell id="msg" value="Mensagem { ID: 99 }" style="rounded=0;fillColor=#4c0519;strokeColor=#e11d48;fontColor=#fecdd3;fontFamily=monospace;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="130" width="160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lam" value="Worker&#10;(Lambda)" style="shape=image;image=https://raw.githubusercontent.com/Helfstein-one/aws-data-mastery/feature/aws-certifications/assets/aws-icons/Lambda.png;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#ffffff;fontFamily=DM Sans;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="200" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- DLQ -->
        <mxCell id="dlq" value="Dead Letter Queue&#10;(SQS DLQ)" style="shape=image;image=https://raw.githubusercontent.com/Helfstein-one/aws-data-mastery/feature/aws-certifications/assets/aws-icons/SimpleQueueService.png;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#e11d48;fontFamily=DM Sans;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="150" width="60" height="60" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" edge="1" parent="1" source="sqs" target="msg">
          <mxGeometry relative="1" as="geometry" />
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10b981;strokeWidth=2;endArrow=block;fontColor=#10b981;" edge="1" parent="1" value="1. ReceiveMessage&#10;(Inicia Timeout)" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="msg" target="lam">
          <mxGeometry relative="1" as="geometry" />
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94a3b8;strokeWidth=1;endArrow=block;" edge="1" parent="1" />
        </mxCell>

        <!-- Cycle / Failure -->
        <mxCell id="fail" edge="1" parent="1" source="lam" target="sqs">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="390" y="300" />
              <mxPoint x="110" y="300" />
            </Array>
          </mxGeometry>
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#e11d48;strokeWidth=2;endArrow=block;fontColor=#e11d48;" edge="1" parent="1" value="2. Falha (Crash)! Mensagem retorna à fila após 30s&#10;ReceiveCount = 1" />
        </mxCell>

        <!-- DLQ Route -->
        <mxCell id="dlq_route" edge="1" parent="1" source="invis" target="dlq">
          <mxGeometry relative="1" as="geometry" />
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#e11d48;strokeWidth=2;endArrow=block;fontColor=#e11d48;" edge="1" parent="1" value="3. Após N falhas (maxReceiveCount=3),&#10;SQS move para DLQ automaticamente." />
        </mxCell>

        <mxCell id="txt" value="Quando a Lambda faz o poll, a mensagem NÃO é deletada. Ela fica 'Invisível' para outras Lambdas concorrentes pelo tempo do Visibility Timeout.
Se a Lambda não chamar 'DeleteMessage' antes desse tempo (porque falhou/crashou), a mensagem volta à Fila e o ciclo repete." style="rounded=1;fillColor=#1e1b4b;strokeColor=#4338ca;fontColor=#c7d2fe;fontFamily=DM Sans;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="360" width="660" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>