# ============================================================
# .gitignore — AWS Data Mastery
# Mantém o repo limpo com apenas assets e páginas do site
# ============================================================

# ─── Sistema Operacional ────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── IDEs e Editores ────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
*.sublime-workspace
*.sublime-project

# ─── Dependências ───────────────────────────────────────────
node_modules/
package-lock.json
yarn.lock
.pnpm-store/

# ─── Scripts de Desenvolvimento ─────────────────────────────
# Todos os arquivos Python (scripts de geração, patch, etc.)
*.py

# ─── Arquivos de Texto e XML ─────────────────────────────────
*.txt
*.xml
*.json
!package.json

# ─── Diretórios de Rascunho / Temporários ────────────────────
scratch/
tmp/
temp/
.tmp/
debug/

# ─── Arquivos de Teste e Debug ───────────────────────────────
test_*.js
test_*.py
test_*.html
*_test.js
*_test.py
*_test.html
*.test.js
*.spec.js
**/test_*

# ─── Scripts de Fix / Patch (descartáveis) ───────────────────
fix_*.js
fix_*.py
patch_*.js
patch_*.py
rebuild_*.py
refactor_*.py
rewrite_*.py
update_*.py
inject_*.py
generate_*.py
gen_*.py
add_*.py
check_*.py
create_*.py
merge_*.py
sync_*.py
scan_*.py
verify_*.py
analyze_*.py
curate_*.py
cleanup_*.py
compress_*.py
upgrade_*.py
smart_*.py
replace_*.py
inline_*.py
count.py
regen_*.py
renumber_*.py
reorder_*.py

# ─── HTML de Rascunho ────────────────────────────────────────
new_sidebar.html
new_*.html
*_draft.html
*_rascunho.html
*_backup.html
*_bak.html
*_old.html

# ─── Arquivos JS de Utilitário / Dev ─────────────────────────
screenshot.js
fix_cases.js
**/js/test_*.js

# ─── Artefatos de Build ───────────────────────────────────────
dist/
build/
out/
.cache/
.parcel-cache/
.next/
.nuxt/

# ─── Cobertura e Relatórios de Teste ─────────────────────────
coverage/
.nyc_output/
*.lcov
*.coverage
htmlcov/
.pytest_cache/
__pycache__/
*.pyc
*.pyo

# ─── Variáveis de Ambiente e Segredos ────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.cert
secrets/
credentials/

# ─── Logs e Dumps ────────────────────────────────────────────
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.dump
*.trace

# ─── Backups Gerados por Editores ────────────────────────────
*.bak
*.orig
*.rej
